    BEGIN
      VALUE "CompanyName", "MadMike"
      VALUE "FileDescription", "Transmutes unique or set items into runes or configurable custom items."
      VALUE "FileVersion", "0.2.3"
      VALUE "InternalName", "ultimate-scrapper"
      VALUE "OriginalFilename", "d2rl-ultimate-scrapper.dll"
      VALUE "ProductName", "Ultimate Scrapper"
      VALUE "ProductVersion", "0.2.3"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
